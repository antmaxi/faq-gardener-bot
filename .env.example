# Answer bot database, opened read-only. Or pass --questions export.json.
ANSWERBOT_DB=../answer-chat-history-bot/data/answerbot.db
GARDENER_DB=data/gardener.db
FAQ_CACHE=data/faq_index

FAQ_REPO=ru-ch/faq
FAQ_SITE=https://ru-ch.github.io/faq

# How far back to read query_log, and how similar questions must be to cluster.
SINCE_DAYS=14
MIN_CLUSTER_SIZE=2
MIN_QUESTION_WORDS=3
CLUSTER_COSINE=0.82
FAQ_TOP_K=4

EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_THREADS=1
# HF_TOKEN=

# anthropic (default), openai, or cursor
LLM_PROVIDER=anthropic
ANSWER_MODEL=
LLM_TIMEOUT=120
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Cursor: pip install 'faq-gardener[cursor]' and a key from cursor.com/dashboard/api
CURSOR_API_KEY=

# This bot's token, not the answer bot's. Admins must /start it once.
TELEGRAM_BOT_TOKEN=
ADMIN_USER_IDS=
